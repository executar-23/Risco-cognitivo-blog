---
import { getCollection } from 'astro:content';
import QRCode from 'qrcode';

import { buttonVariants } from '@/components/ui/button';
import { ROUTE_GROUPS, ROUTES, absoluteUrl, baseUrl, type HubEntry } from '@/data/routes';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { cn } from '@/lib/utils';

// Hub de rotas e links (ADR-07). A fonte é src/data/routes.ts; os artigos vêm da coleção do blog.
const base = baseUrl(import.meta.env.PUBLIC_ROUTES_BASE_URL);
const posts = await getCollection('blog');
const blogEntries: HubEntry[] = posts
  .map((p) => ({
    id: `blog-${p.id}`,
    title: p.data.title,
    group: 'Blog' as const,
    kind: 'route' as const,
    path: `/blog/${p.id}/`,
    exposure: 'public' as const,
    addedAt: p.data.pubDate.toISOString().slice(0, 10),
    source: 'src/content/blog',
  }))
  .sort((a, b) => a.path.localeCompare(b.path));

const entries = [...ROUTES, ...blogEntries].sort(
  (a, b) => ROUTE_GROUPS.indexOf(a.group) - ROUTE_GROUPS.indexOf(b.group),
);

// QR precisa de contraste máximo para leitura por câmera: preto sobre branco, fora dos tokens de tema.
const withQr = await Promise.all(
  entries.map(async (e) => {
    const url = absoluteUrl(e, base);
    const svg = await QRCode.toString(url, {
      type: 'svg',
      margin: 2,
      errorCorrectionLevel: 'M',
      color: { dark: '#000000', light: '#ffffff' },
    });
    return { ...e, url, svg };
  }),
);

const links = withQr.filter((e) => e.kind === 'link');
const exposureLabel = { public: 'Pública', internal: 'Interno exposto', test: 'Estado de teste' } as const;
const exposureTone = {
  public: 'border-[color:var(--color-brand-soft)] bg-[var(--color-brand-subtle)] text-[var(--color-brand-default)]',
  internal: 'border-[color:var(--color-attention-soft)] bg-[var(--color-attention-subtle)] text-[var(--color-attention-default)]',
  test: 'bg-muted text-muted-foreground',
} as const;
const counts = {
  total: withQr.length,
  groups: new Set(withQr.map((e) => e.group)).size,
  internal: withQr.filter((e) => e.exposure === 'internal').length,
  links: links.length,
};
const h2 = 'text-primary scroll-mt-28 text-4xl font-medium';
---

<DefaultLayout title="Rotas e links" description="Hub de rotas e links do Risco Cognitivo, com QR Code de cada endereço.">
  <div class="container max-w-5xl pt-32 pb-24 lg:pt-44">
    <p class="text-muted-foreground text-sm font-medium" data-hub-hide-print><a href="/admin" class="hover:underline">Painel</a> / Rotas e links</p>
    <h1 class="mt-2 text-3xl tracking-tight sm:text-4xl md:text-5xl lg:text-6xl">Rotas e links</h1>
    <p class="text-muted-foreground mt-3 max-w-2xl text-lg font-medium">
      Catálogo de todas as rotas e links do projeto, com QR Code. Toda nova rota ou link gerado entra aqui, no
      mesmo PR: o registro fica em <code>src/data/routes.ts</code> e o teste <code>npm run routes:check</code> bloqueia o que faltar.
    </p>

    <dl class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4" data-testid="hub-summary">
      <div class="bg-card rounded-xl border p-4"><dt class="text-muted-foreground text-sm">Entradas</dt><dd class="text-3xl font-medium tabular-nums" data-count="total">{counts.total}</dd></div>
      <div class="bg-card rounded-xl border p-4"><dt class="text-muted-foreground text-sm">Grupos</dt><dd class="text-3xl font-medium tabular-nums">{counts.groups}</dd></div>
      <div class="bg-card rounded-xl border p-4"><dt class="text-muted-foreground text-sm">Internas expostas</dt><dd class="text-3xl font-medium tabular-nums">{counts.internal}</dd></div>
      <div class="bg-card rounded-xl border p-4"><dt class="text-muted-foreground text-sm">Links gerados</dt><dd class="text-3xl font-medium tabular-nums">{counts.links}</dd></div>
    </dl>
    <p class="text-muted-foreground-subtle mt-3 text-sm" data-testid="hub-base"><strong class="text-muted-foreground">Base dos QRs:</strong> <code>{base}</code></p>

    <div class="mt-8 flex flex-wrap items-center gap-3" data-hub-hide-print>
      <label class="sr-only" for="hub-search">Filtrar por nome, rota ou URL</label>
      <input id="hub-search" type="search" placeholder="Filtrar por nome, rota ou URL…" class="border-input bg-background h-10 min-w-0 flex-1 basis-64 rounded-md border px-3 text-base" />
      <label class="sr-only" for="hub-group">Grupo</label>
      <select id="hub-group" class="border-input bg-background h-10 rounded-md border px-3 text-base">
        <option value="">Todos os grupos</option>
        {ROUTE_GROUPS.map((g) => <option value={g}>{g}</option>)}
      </select>
      <label class="sr-only" for="hub-exposure">Exposição</label>
      <select id="hub-exposure" class="border-input bg-background h-10 rounded-md border px-3 text-base">
        <option value="">Toda exposição</option>
        <option value="public">Pública</option>
        <option value="internal">Interno exposto</option>
        <option value="test">Estado de teste</option>
      </select>
      <button type="button" data-print class={buttonVariants({ variant: 'outline' })}>Imprimir / PDF</button>
    </div>
    <p class="text-muted-foreground mt-3 text-sm" role="status" aria-live="polite" data-hub-status data-hub-hide-print></p>

    <section id="catalogo" class="mt-10" aria-labelledby="catalogo-title">
      <h2 id="catalogo-title" class="sr-only">Catálogo</h2>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2" id="hub-grid" data-testid="hub-grid">
        {withQr.map((e) => (
          <article
            class="route-card bg-card flex min-w-0 gap-4 rounded-xl border p-4"
            data-id={e.id}
            data-kind={e.kind}
            data-group={e.group}
            data-exposure={e.exposure}
            data-search={`${e.title} ${e.path ?? ''} ${e.url}`.toLowerCase()}
          >
            <div
              role="img"
              aria-label={`QR Code para ${e.title}`}
              class="size-28 shrink-0 self-start overflow-hidden rounded-lg border bg-white [&>svg]:size-full"
              set:html={e.svg}
            />
            <div class="flex min-w-0 flex-1 flex-col gap-1">
              <p class="text-muted-foreground-subtle text-xs font-medium tracking-wide uppercase">{e.group}</p>
              <h3 class="text-lg font-medium leading-snug">{e.title}</h3>
              {e.kind === 'route' && <code class="text-sm break-all">{e.path}</code>}
              <a class="text-primary text-sm break-all underline-offset-4 hover:underline" href={e.url} target="_blank" rel="noopener noreferrer">{e.url}</a>
              {e.description && <p class="text-muted-foreground text-sm">{e.description}</p>}
              <div class="mt-2 flex flex-wrap items-center gap-2">
                <span class={cn('inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium', exposureTone[e.exposure])}>{exposureLabel[e.exposure]}</span>
                <a class={buttonVariants({ size: 'sm' })} href={e.url} target="_blank" rel="noopener noreferrer">Abrir</a>
                <button type="button" class={buttonVariants({ variant: 'outline', size: 'sm' })} data-copy={e.url}><span data-copy-label>Copiar URL</span></button>
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="text-muted-foreground mt-4 hidden text-base" data-hub-empty>Nenhuma entrada corresponde ao filtro.</p>
    </section>

    <section id="registro" class="mt-20" aria-labelledby="registro-title" data-hub-hide-print>
      <h2 id="registro-title" class={h2}>Registro</h2>
      <p class="text-muted-foreground mt-3 max-w-2xl text-lg font-medium">Auditoria de cada entrada: origem, responsável e data de inclusão.</p>
      <div class="mt-6 overflow-x-auto" data-testid="hub-registry">
        <table class="ds-table">
          <caption class="sr-only">Registro de rotas e links</caption>
          <thead><tr><th scope="col">Id</th><th scope="col">Título</th><th scope="col">Endereço</th><th scope="col">Exposição</th><th scope="col">Incluída em</th><th scope="col">Origem</th></tr></thead>
          <tbody>
            {withQr.map((e) => (
              <tr>
                <td><code>{e.id}</code></td>
                <td>{e.title}</td>
                <td>{e.kind === 'route' ? <code>{e.path}</code> : <a href={e.url} rel="noopener noreferrer">{e.url}</a>}</td>
                <td>{exposureLabel[e.exposure]}</td>
                <td>{e.addedAt}</td>
                <td>{e.source ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="workflow" class="mt-20" aria-labelledby="workflow-title" data-hub-hide-print>
      <h2 id="workflow-title" class={h2}>Como registrar</h2>
      <ol class="text-muted-foreground mt-6 max-w-2xl list-decimal space-y-2 pl-5 text-lg font-medium">
        <li>Crie a página em <code>src/pages</code>, a ferramenta em <code>public/&lt;pasta&gt;/index.html</code> ou gere o link.</li>
        <li>Acrescente a entrada em <code>src/data/routes.ts</code> (rota: <code>path</code>; link: <code>url</code> https).</li>
        <li>Rode <code>npm run routes:check</code>: ele lista o que faltar.</li>
        <li>Confira o QR e a URL neste catálogo; artigos do blog entram sozinhos.</li>
        <li>Marque o item no checklist do PR.</li>
      </ol>
      <p class="text-muted-foreground mt-4 max-w-2xl text-base font-medium">Detalhes em <code>docs/design-system/ROUTES-HUB-WORKFLOW-001.md</code> e no ADR-07 do <code>CLAUDE.md</code>.</p>
      <p class="mt-6"><a class={buttonVariants({ variant: 'outline' })} href="/admin/tools/qr-python.zip" download>Baixar módulos Python (tools/qr-python)</a></p>
      <p class="text-muted-foreground-subtle mt-2 max-w-2xl text-sm">Arquivo de referência do gerador DESK-OS Sprint; está incompleto (veja o README dentro do zip) e não gera este catálogo.</p>
    </section>
  </div>

  <style is:global>
    @media print {
      [data-hub-hide-print],
      nav[aria-label='Main'],
      footer,
      .fixed {
        display: none !important;
      }
      .route-card {
        break-inside: avoid;
        box-shadow: none;
      }
    }
  </style>

  <script>
    const search = document.getElementById('hub-search') as HTMLInputElement;
    const group = document.getElementById('hub-group') as HTMLSelectElement;
    const exposure = document.getElementById('hub-exposure') as HTMLSelectElement;
    const cards = [...document.querySelectorAll<HTMLElement>('.route-card')];
    const status = document.querySelector<HTMLElement>('[data-hub-status]');
    const empty = document.querySelector<HTMLElement>('[data-hub-empty]');

    function applyFilters() {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const ok =
          (!q || card.dataset.search!.includes(q)) &&
          (!group.value || card.dataset.group === group.value) &&
          (!exposure.value || card.dataset.exposure === exposure.value);
        card.classList.toggle('hidden', !ok);
        if (ok) shown++;
      }
      if (status) status.textContent = q || group.value || exposure.value ? `${shown} de ${cards.length} entradas` : '';
      empty?.classList.toggle('hidden', shown > 0);
    }
    search.addEventListener('input', applyFilters);
    group.addEventListener('change', applyFilters);
    exposure.addEventListener('change', applyFilters);

    document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

    document.addEventListener('click', async (ev) => {
      const btn = (ev.target as Element).closest<HTMLElement>('[data-copy]');
      if (!btn) return;
      const label = btn.querySelector('[data-copy-label]') as HTMLElement;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        const old = label.textContent;
        label.textContent = 'Copiado';
        setTimeout(() => (label.textContent = old), 1400);
      } catch {
        window.prompt('Copie a URL:', btn.dataset.copy!);
      }
    });
  </script>
</DefaultLayout>
