---
// Página de artigo (mood board 03): eyebrow território/tipo, título display, lead, meta mono,
// corpo em prosa e coluna lateral com pergunta do território, leitura seguinte, assuntos e evidências.
// Renderizada no servidor (antes era client:only), legível sem JavaScript e indexável.
import { render } from "astro:content";
import { ArrowRight } from "lucide-react";

import ArticleMeta from "@/components/editorial/ArticleMeta.astro";
import EvidenceTable from "@/components/editorial/EvidenceTable.astro";
import { SURFACE, SURFACE_LINK } from "@/components/editorial/surface";
import { AsciiDiagram, PlainTextPanel } from "@/components/plain";
import { Callout } from "@/components/ui/callout";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { evidenceFor, territoryHref } from "@/lib/editorial";
import { type PostView, formatDate, getPosts, typeLabel } from "@/lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

interface Props {
  post: PostView;
  all: PostView[];
}

const { post, all } = Astro.props;
const { Content } = await render(post.entry);
const evidence = evidenceFor(post.evidence);
const byOrder = [...all].sort((a, b) => a.territory.order - b.territory.order || a.pubDate.valueOf() - b.pubDate.valueOf());
const idx = byOrder.findIndex((p) => p.id === post.id);
const next = [...byOrder.slice(idx + 1), ...byOrder.slice(0, idx)].slice(0, 2);
const updated = post.entry.data.updatedDate;
---

<DefaultLayout title={post.entry.data.seoTitle ?? post.title} description={post.description} image={post.image}>
  <article class="container pt-10 lg:pt-16" aria-labelledby="article-title">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16">
      <div class="min-w-0">
        <header>
          <p class="rc-eyebrow flex flex-wrap gap-2">
            <a href={territoryHref(post.territory)} class="text-primary hover:underline">{post.territory.name}</a>
            <span aria-hidden="true">/</span>
            <span class="text-primary">{typeLabel(post.type)}</span>
          </p>
          <h1 id="article-title" class="rc-display mt-4 text-4xl sm:text-5xl lg:text-6xl">{post.title}</h1>
          <p class="rc-lead mt-6 text-lg sm:text-xl">{post.description}</p>
          <ArticleMeta post={post} class="mt-6" />
          {updated && <p class="rc-meta mt-2">Atualizado em {formatDate(updated)}</p>}
          {post.image && (
            <img
              src={post.image}
              alt=""
              class="mt-8 aspect-[16/9] w-full rounded-[var(--surface-radius-card)] border border-[var(--border-default)] object-cover"
            />
          )}
        </header>

        <div class="rc-prose prose prose-lg dark:prose-invert mt-10 max-w-[var(--editorial-measure)]">
          <Content components={{ AsciiDiagram, PlainTextPanel, Callout }} />
        </div>

        {evidence.length > 0 && (
          <section class="mt-14" aria-labelledby="evidencias-artigo">
            <p class="rc-eyebrow">Evidências do banco editorial</p>
            <h2 id="evidencias-artigo" class="rc-title mt-2 text-2xl">Fontes citadas neste artigo</h2>
            <div class="mt-6">
              <EvidenceTable items={evidence} caption={`Evidências citadas em ${post.title}`} compact />
            </div>
            <p class="text-muted-foreground mt-3 text-sm">
              Registros completos em <a href="/evidencias/" class="rc-link">Evidências</a>.
            </p>
          </section>
        )}
      </div>

      <aside class="flex flex-col gap-8 lg:sticky lg:top-24 lg:self-start" aria-label="Contexto do artigo">
        <div class:list={[SURFACE, "p-6"]}>
          <p class="rc-eyebrow text-primary">Pergunta do território</p>
          <p class="rc-title mt-3 text-2xl">{post.territory.question}</p>
          <p class="text-muted-foreground mt-3 text-sm">
            {post.territory.name} · {post.territory.role}. Não confundir com: {post.territory.notToConfuse.join(", ")}.
          </p>
        </div>

        {next.length > 0 && (
          <nav aria-labelledby="leia-tambem">
            <p id="leia-tambem" class="rc-eyebrow">Leia também</p>
            <ul class="mt-4 flex flex-col gap-3">
              {next.map((p) => (
                <li>
                  <a href={p.href} class:list={["group flex items-start justify-between gap-3 p-4", SURFACE_LINK]}>
                    <span>
                      <span class="rc-eyebrow text-primary block">{p.territory.short}</span>
                      <span class="rc-title mt-1.5 block text-base">{p.title}</span>
                      <span class="rc-meta mt-2 block">{p.minutes} min</span>
                    </span>
                    <ArrowRight className="text-primary mt-1 size-4 shrink-0" aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        {post.tags.length > 0 && (
          <div>
            <p class="rc-eyebrow">Assuntos</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {post.tags.map((tag) => (
                <li>
                  <a
                    href={`/buscar/?q=${encodeURIComponent(tag)}`}
                    class="text-foreground inline-flex h-8 items-center rounded-full bg-[var(--surface-hover)] px-3 text-sm transition-colors hover:bg-[var(--surface-selected)]"
                  >
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </article>
</DefaultLayout>
