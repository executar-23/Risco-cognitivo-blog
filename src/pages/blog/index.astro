---
// Arquivo de artigos (mood board 04): "Explore por assunto", filtro por território,
// destaque à esquerda e lista numerada à direita. Tudo vem da coleção + banco editorial.
import ArticleCard from "@/components/editorial/ArticleCard.astro";
import FilterChips from "@/components/editorial/FilterChips.astro";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { TERRITORIES } from "@/lib/editorial";
import { getPosts } from "@/lib/posts";

const posts = await getPosts();
const [featured, ...rest] = posts;
const options = TERRITORIES.filter((t) => posts.some((p) => p.territory.slug === t.slug)).map((t) => ({
  slug: t.slug,
  label: t.short,
}));
---

<DefaultLayout
  title="Artigos"
  description="Artigos do Risco Cognitivo por território: fatores, exposição, eventos, controles, indicadores, gestão e framework."
>
  <section class="container pt-12 pb-10 lg:pt-20" aria-labelledby="blog-title">
    <p class="rc-eyebrow">Explorar</p>
    <div class="mt-4 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <h1 id="blog-title" class="rc-display text-5xl sm:text-6xl lg:text-7xl">Explore por assunto</h1>
        <p class="rc-lead mt-5 max-w-2xl text-lg sm:text-xl">
          Artigos e ensaios sobre como a cognição participa da formação do risco — e sobre o que reduz, mede e
          acompanha esse risco no trabalho.
        </p>
      </div>
    </div>
    <div class="mt-8">
      <FilterChips options={options} label="Filtrar artigos por território" />
    </div>
  </section>

  <section class="container" data-filter-scope aria-label="Artigos">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
      <div>{featured && <ArticleCard post={featured} variant="feature" headingLevel={2} />}</div>
      <div class="lg:border-l lg:border-[var(--border-default)] lg:pl-10">
        <h2 class="sr-only">Todos os artigos</h2>
        {rest.map((post, i) => <ArticleCard post={post} variant="row" index={i + 2} headingLevel={3} />)}
        <p data-filter-empty hidden class="text-muted-foreground py-6">Nenhum outro artigo neste território ainda.</p>
      </div>
    </div>
  </section>
</DefaultLayout>
