---
import { getCollection } from 'astro:content';

import { buttonVariants } from '@/components/ui/button';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { cn } from '@/lib/utils';

const ARTICLE = '/blog/do-risco-cognitivo-a-execucao-assistida/';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
const more = rest.slice(0, 3);
const older = rest.slice(3);

const dateFmt = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
const readingTime = (body = '') =>
  Math.max(1, Math.ceil(body.replace(/<[^>]+>/g, ' ').trim().split(/\s+/).length / 200));

const filters = [
  { id: 'todos', label: 'Todos' },
  { id: 'riscos', label: 'Riscos' },
  { id: 'processos', label: 'Processos' },
  { id: 'ferramentas', label: 'Ferramentas' },
  { id: 'metodo', label: 'Método' },
];

const territories = [
  { title: 'Riscos Cognitivos', subtitle: 'Reconhecer a exposição', href: `${ARTICLE}#riscos`, image: '/about/1.webp', category: 'riscos' },
  { title: 'Processos Neuroadaptativos', subtitle: 'Redesenhar o trabalho', href: `${ARTICLE}#processos`, image: '/about/2.webp', category: 'processos' },
  { title: 'Ferramentas & Execução', subtitle: 'Demonstrar a aplicação', href: `${ARTICLE}#ferramentas`, image: '/about/3.webp', category: 'ferramentas' },
  { title: 'Níveis de consciência', subtitle: 'Descoberta, compreensão e decisão', href: `${ARTICLE}#consciencia`, image: '/about/4.webp', category: 'metodo' },
];
---

<DefaultLayout
  title="Risco Cognitivo"
  description="Compreender riscos. Redesenhar processos. Apoiar a execução."
>
  <!-- Hero -->
  <section class="container max-w-5xl pt-32 pb-16 lg:pt-44 lg:pb-24">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="max-w-xl">
        <h1 class="text-3xl tracking-tight sm:text-4xl md:text-5xl lg:text-6xl">
          Compreender riscos, redesenhar o
          <span class="text-primary decoration-primary/40 underline decoration-wavy decoration-2 underline-offset-8">trabalho</span>
        </h1>
        <p class="text-muted-foreground mt-6 text-lg font-medium">
          Compreender o problema. Redesenhar o trabalho. Criar condições para executar.
          Os três pilares do Risco Cognitivo.
        </p>
        <a
          href={ARTICLE}
          class={cn(buttonVariants({ size: 'lg' }), 'mt-8')}
        >
          Conhecer a tese
        </a>
      </div>

      <div class="grid grid-cols-5 grid-rows-2 gap-3 sm:gap-4">
        <img
          src="/blog/do-risco-cognitivo-a-execucao-assistida/hero.jpg"
          alt="Uma pessoa sustenta uma enorme tecla Ctrl amarela."
          class="col-span-3 row-span-2 aspect-[4/5] w-full rounded-2xl border object-cover"
          width="1080"
          height="1350"
        />
        <img src="/about/1.webp" alt="" class="col-span-2 h-full w-full rounded-2xl border object-cover" loading="lazy" />
        <img src="/about/2.webp" alt="" class="col-span-2 h-full w-full rounded-2xl border object-cover" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Territórios -->
  <section class="container max-w-5xl py-12 lg:py-16" aria-labelledby="territorios-title">
    <h2 id="territorios-title" class="text-primary text-4xl font-medium">Territórios</h2>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar territórios">
        {filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'aria-pressed:border-foreground aria-pressed:bg-foreground aria-pressed:text-background aria-pressed:hover:bg-foreground/90 aria-pressed:hover:text-background')}
          >
            {f.label}
          </button>
        ))}
      </div>
      <a href={ARTICLE} class={cn(buttonVariants({ variant: 'outline' }), 'hidden md:inline-flex')}>
        Explorar todos os territórios
      </a>
    </div>

    <div class="-mx-6 mt-8 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pb-2 md:mx-0 md:grid md:grid-cols-4 md:overflow-visible md:px-0">
      {territories.map((t) => (
        <a href={t.href} data-category={t.category} class="group w-[75%] shrink-0 snap-start md:w-auto">
          <div class="overflow-hidden rounded-2xl border">
            <img
              src={t.image}
              alt=""
              loading="lazy"
              class="aspect-[4/5] w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
          <p class="mt-3 text-lg font-medium">{t.title}</p>
          <p class="text-muted-foreground text-sm">{t.subtitle}</p>
        </a>
      ))}
    </div>

    <a href={ARTICLE} class={cn(buttonVariants({ variant: 'outline' }), 'mx-auto mt-8 flex w-fit md:hidden')}>
      Explorar todos os territórios
    </a>
  </section>

  <!-- Últimos artigos -->
  {featured && (
    <section class="container max-w-5xl py-12 lg:py-16" aria-labelledby="artigos-title">
      <div class="flex items-center justify-between gap-4">
        <h2 id="artigos-title" class="text-primary text-4xl font-medium">Últimos artigos</h2>
        {older.length > 0 && (
          <a href="#mais-artigos" class={cn(buttonVariants({ variant: 'outline' }), 'hidden md:inline-flex')}>
            Ver todos os artigos
          </a>
        )}
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-12">
        <a href={`/blog/${featured.id}/`} class="group lg:col-span-7">
          {featured.data.image && (
            <div class="overflow-hidden rounded-2xl border">
              <img src={featured.data.image} alt="" class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105" />
            </div>
          )}
          <p class="text-primary mt-4 text-sm font-medium">{featured.data.authorName ?? 'Artigo'}</p>
          <h3 class="mt-1 text-2xl font-medium tracking-tight group-hover:underline">{featured.data.title}</h3>
          <p class="text-muted-foreground mt-2 text-sm">
            {dateFmt.format(featured.data.pubDate)} · {readingTime(featured.body)} min de leitura
          </p>
          <p class="text-muted-foreground mt-3 line-clamp-3 text-lg font-medium">{featured.data.description}</p>
        </a>

        <ul class="flex flex-col gap-6 lg:col-span-5">
          {more.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="group flex gap-4">
                {post.data.image && (
                  <img src={post.data.image} alt="" loading="lazy" class="size-24 shrink-0 rounded-2xl border object-cover" />
                )}
                <div>
                  <p class="text-primary text-xs font-medium">{post.data.authorName ?? 'Artigo'}</p>
                  <h3 class="mt-1 line-clamp-3 text-lg leading-snug font-medium group-hover:underline">{post.data.title}</h3>
                  <p class="text-muted-foreground mt-1 text-xs">
                    {dateFmt.format(post.data.pubDate)} · {readingTime(post.body)} min de leitura
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {older.length > 0 && (
        <a href="#mais-artigos" class={cn(buttonVariants({ variant: 'outline' }), 'mx-auto mt-8 flex w-fit md:hidden')}>
          Ver todos os artigos
        </a>
      )}
    </section>
  )}

  {older.length > 0 && (
    <section id="mais-artigos" class="container max-w-5xl scroll-mt-24 py-12 lg:py-16" aria-labelledby="mais-artigos-title">
      <h2 id="mais-artigos-title" class="text-primary text-4xl font-medium">Mais artigos</h2>
      <ul class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {older.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="group block">
              {post.data.image && (
                <div class="overflow-hidden rounded-2xl border">
                  <img src={post.data.image} alt="" loading="lazy" class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                </div>
              )}
              <p class="text-primary mt-4 text-xs font-medium">{post.data.authorName ?? 'Artigo'}</p>
              <h3 class="mt-1 text-lg font-medium group-hover:underline">{post.data.title}</h3>
              <p class="text-muted-foreground mt-1 text-xs">
                {dateFmt.format(post.data.pubDate)} · {readingTime(post.body)} min de leitura
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Destaques -->
  <section class="container max-w-5xl py-12 lg:py-16" aria-labelledby="destaques-title">
    <h2 id="destaques-title" class="text-primary text-4xl font-medium">Destaques</h2>

    <div class="mt-8 grid gap-6 lg:grid-cols-12">
      <figure class="bg-card rounded-2xl border p-6 lg:col-span-5">
        <div class="flex items-center gap-3">
          <span class="bg-foreground text-background flex size-10 items-center justify-center rounded-full font-semibold">R</span>
          <div>
            <p class="font-medium">Risco Cognitivo</p>
            <p class="text-muted-foreground text-sm">Manifesto editorial</p>
          </div>
        </div>
        <blockquote class="text-primary mt-6 text-2xl leading-snug font-medium">
          “A adaptação também precisa acontecer no sistema de trabalho.”
        </blockquote>
        <p class="text-muted-foreground mt-4 text-lg font-medium">
          Quando o trabalho exige que alguém sustente sozinho toda a complexidade, pedir mais esforço pode deixar
          o problema intacto.
        </p>
        <a href={ARTICLE} class="text-primary mt-4 inline-block text-sm font-medium hover:underline">Ler o manifesto</a>
      </figure>

      <a href="/hub-editorial/" class="group relative overflow-hidden rounded-2xl border lg:col-span-4">
        <img src="/about/3.webp" alt="" loading="lazy" class="h-full min-h-64 w-full object-cover transition-transform duration-300 group-hover:scale-105" />
        <span class="bg-background/85 absolute inset-x-3 bottom-3 rounded-xl px-4 py-3 text-sm font-medium backdrop-blur">
          Hub Editorial
        </span>
      </a>

      <div class="flex flex-col gap-4 lg:col-span-3">
        <a href="/skills/" class="group relative flex-1 overflow-hidden rounded-2xl border">
          <img src="/about/4.webp" alt="" loading="lazy" class="h-full min-h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105" />
          <span class="bg-background/85 absolute inset-x-3 bottom-3 rounded-xl px-4 py-3 text-sm font-medium backdrop-blur">
            Catálogo de Skills EXECUTAR
          </span>
        </a>
        <a href="/admin" class={cn(buttonVariants({ variant: 'outline' }), 'self-end')}>
          Ver todos os destaques
        </a>
      </div>
    </div>
  </section>

  <!-- Chamada: acompanhar novos artigos -->
  <section class="relative mt-12 overflow-hidden">
    <img src="/about/2.webp" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative container max-w-5xl py-20 text-center text-white lg:py-28">
      <h2 class="mx-auto max-w-2xl text-4xl font-medium text-balance">
        Acompanhe os novos artigos do Risco Cognitivo
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg font-medium text-white/80">
        Assine o feed RSS no seu leitor ou fale com a gente para receber novidades.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/rss.xml" class={buttonVariants({ size: 'lg' })}>
          Assinar via RSS
        </a>
        <a href="/contact" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'text-foreground')}>
          Fale conosco
        </a>
      </div>
    </div>
  </section>
</DefaultLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      cards.forEach((card) => {
        card.hidden = filter !== 'todos' && card.dataset.category !== filter;
      });
    }),
  );
</script>
