---
import { ArrowRight } from "lucide-react";

import PageHero from "@/components/editorial/PageHero.astro";
import { buttonVariants } from "@/components/ui/button";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { cn } from "@/lib/utils";
---

<DefaultLayout title="Página não encontrada" description="O endereço procurado não existe ou mudou." noindex>
  <PageHero eyebrow="Erro 404" title="Página não encontrada" lead="O endereço não existe ou mudou de lugar. Os artigos de demonstração antigos foram substituídos pelos territórios do framework.">
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href="/blog/" class={cn(buttonVariants({ size: "lg" }), "gap-2")}>Ver os artigos <ArrowRight className="size-4" aria-hidden="true" /></a>
      <a href="/temas/" class="rc-link">Mapa de temas</a>
      <a href="/buscar/" class="rc-link">Buscar</a>
    </div>
  </PageHero>
</DefaultLayout>
