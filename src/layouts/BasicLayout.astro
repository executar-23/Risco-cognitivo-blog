---
// Página de texto corrido (Markdown/MDX em src/pages), ex.: /privacy/.
import DefaultLayout from "@/layouts/DefaultLayout.astro";

const { title, description, eyebrow } = Astro.props.frontmatter ?? Astro.props;
---

<DefaultLayout title={title} description={description}>
  <section class="container max-w-3xl pt-12 pb-8 lg:pt-20">
    {eyebrow && <p class="rc-eyebrow">{eyebrow}</p>}
    {title && <h1 class="rc-display mt-4 text-4xl sm:text-5xl lg:text-6xl">{title}</h1>}
    {description && <p class="rc-lead mt-6 text-lg sm:text-xl">{description}</p>}
  </section>
  <article class="prose prose-lg dark:prose-invert prose-headings:rc-title container max-w-3xl" data-plain-page>
    <slot />
  </article>
</DefaultLayout>
