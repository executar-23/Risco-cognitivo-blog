{
  // Cloudflare Workers config for serving the pre-built Astro static site.
  "account_id": "92fdc1b556435f2e3d62517f3041422e",
  "name": "risco-cognitivo-blog",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Astro's static build output ("astro build" -> output: "static")
    "directory": "./dist",
    "binding": "ASSETS",
    // src/pages/404.astro builds to dist/404.html
    "not_found_handling": "404-page"
  },
  // Required by `wrangler preview` (branch preview builds); empty = inherit top-level settings
  "previews": {},
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
